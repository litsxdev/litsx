{
  "name": "@litsx/unocss",
  "version": "1.0.0-next.1",
  "description": "UnoCSS integration for LitSX component styles",
  "author": "LitSX Team",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "import": "./src/vite.js",
      "require": "./dist/vite.cjs",
      "default": "./src/vite.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "litsx",
    "unocss",
    "lit",
    "shadow-dom",
    "vite"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "homepage": "https://litsx.dev/",
  "bugs": {
    "url": "https://github.com/litsxdev/litsx/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/litsxdev/litsx.git",
    "directory": "packages/unocss"
  },
  "peerDependencies": {
    "@litsx/vite-plugin": "^1.0.0-next.0",
    "unocss": ">=66",
    "vite": "^7.3.2 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@litsx/vite-plugin": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@litsx/compiler": "^1.0.0-next.2"
  },
  "scripts": {
    "build": "../../node_modules/.bin/rollup --config rollup.config.js",
    "prepack": "yarn build"
  }
}
