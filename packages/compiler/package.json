{
  "name": "@litsx/compiler",
  "version": "1.0.0-next.8",
  "description": "Build-facing LitSX compilation facade with correct parser and sourcemap handling",
  "author": "LitSX Team",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    },
    "./authored-input": {
      "types": "./src/authored-input.d.ts",
      "import": "./src/authored-input.js",
      "require": "./dist/authored-input.cjs",
      "default": "./src/authored-input.js"
    },
    "./utility-css": {
      "types": "./src/utility-css.d.ts",
      "import": "./src/utility-css.js",
      "require": "./dist/utility-css.cjs",
      "default": "./src/utility-css.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "litsx",
    "compiler",
    "babel",
    "vite",
    "jsx"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "homepage": "https://litsx.dev/",
  "bugs": {
    "url": "https://github.com/litsxdev/litsx/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/litsxdev/litsx.git",
    "directory": "packages/compiler"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/parser": "^8.0.4",
    "@babel/plugin-transform-typescript": "^8.0.1",
    "@babel/types": "^8.0.4",
    "@litsx/authoring": "^1.0.0-next.4",
    "@litsx/babel-plugin-transform-jsx-html-template": "^1.0.0-next.6",
    "@litsx/babel-preset-litsx": "^1.0.0-next.6",
    "@litsx/babel-preset-react-compat": "^1.0.0-next.3",
    "@litsx/typescript-session": "^1.0.0-next.0",
    "source-map-js": "^1.2.1"
  },
  "scripts": {
    "build": "../../node_modules/.bin/rollup --config rollup.config.js",
    "prepack": "yarn build"
  }
}
