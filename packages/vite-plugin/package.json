{
  "name": "@litsx/vite-plugin",
  "version": "1.0.0-next.1",
  "description": "Official Vite plugin for LitSX compilation",
  "author": "LitSX Team",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    },
    "./ssr": {
      "types": "./src/ssr.d.ts",
      "import": "./src/ssr.js",
      "require": "./dist/ssr.cjs",
      "default": "./src/ssr.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "litsx",
    "vite",
    "plugin",
    "lit",
    "jsx"
  ],
  "license": "Apache-2.0",
  "homepage": "https://litsx.dev/",
  "bugs": {
    "url": "https://github.com/litsxdev/litsx/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/litsxdev/litsx.git",
    "directory": "packages/vite-plugin"
  },
  "peerDependencies": {
    "@litsx/ssr": "^1.0.0-next.4",
    "vite": "^7.3.2 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@litsx/ssr": {
      "optional": true
    }
  },
  "dependencies": {
    "@litsx/compiler": "^1.0.0-next.9"
  },
  "scripts": {
    "build": "../../node_modules/.bin/rollup --config rollup.config.js",
    "prepack": "yarn build"
  }
}
