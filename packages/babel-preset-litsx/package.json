{
  "name": "@litsx/babel-preset-litsx",
  "version": "1.0.0-next.2",
  "description": "Canonical native Babel preset for LitSX-authored source",
  "author": "LitSX Team",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    },
    "./pipeline": {
      "import": "./src/pipeline.js",
      "require": "./dist/pipeline.cjs",
      "default": "./src/pipeline.js"
    },
    "./internal/transform-litsx-components": {
      "import": "./src/internal/transform-litsx-components.js",
      "require": "./dist/internal/transform-litsx-components.cjs",
      "default": "./src/internal/transform-litsx-components.js"
    },
    "./internal/transform-litsx-renderer-props": {
      "import": "./src/internal/transform-litsx-renderer-props.js",
      "require": "./dist/internal/transform-litsx-renderer-props.cjs",
      "default": "./src/internal/transform-litsx-renderer-props.js"
    },
    "./internal/transform-litsx-dom-refs": {
      "import": "./src/internal/transform-litsx-dom-refs.js",
      "require": "./dist/internal/transform-litsx-dom-refs.cjs",
      "default": "./src/internal/transform-litsx-dom-refs.js"
    },
    "./internal/transform-litsx-hooks": {
      "import": "./src/internal/transform-litsx-hooks.js",
      "require": "./dist/internal/transform-litsx-hooks.cjs",
      "default": "./src/internal/transform-litsx-hooks.js"
    },
    "./internal/transform-litsx-properties": {
      "import": "./src/internal/transform-litsx-properties.js",
      "require": "./dist/internal/transform-litsx-properties.cjs",
      "default": "./src/internal/transform-litsx-properties.js"
    },
    "./internal/transform-litsx-jsx-bindings": {
      "import": "./src/internal/transform-litsx-jsx-bindings.js",
      "require": "./dist/internal/transform-litsx-jsx-bindings.cjs",
      "default": "./src/internal/transform-litsx-jsx-bindings.js"
    },
    "./internal/transform-litsx-static-assignments": {
      "import": "./src/internal/transform-litsx-static-assignments.js",
      "require": "./dist/internal/transform-litsx-static-assignments.cjs",
      "default": "./src/internal/transform-litsx-static-assignments.js"
    },
    "./internal/transform-litsx-static-ir": {
      "import": "./src/internal/transform-litsx-static-ir.js",
      "require": "./dist/internal/transform-litsx-static-ir.cjs",
      "default": "./src/internal/transform-litsx-static-ir.js"
    },
    "./internal/transform-litsx-lazy": {
      "import": "./src/internal/transform-litsx-lazy.js",
      "require": "./dist/internal/transform-litsx-lazy.cjs",
      "default": "./src/internal/transform-litsx-lazy.js"
    },
    "./internal/transform-litsx-lazy-analysis": {
      "import": "./src/internal/transform-litsx-lazy-analysis.js",
      "require": "./dist/internal/transform-litsx-lazy-analysis.cjs",
      "default": "./src/internal/transform-litsx-lazy-analysis.js"
    },
    "./internal/transform-typescript-namespace-collisions": {
      "import": "./src/internal/transform-typescript-namespace-collisions.js",
      "require": "./dist/internal/transform-typescript-namespace-collisions.cjs",
      "default": "./src/internal/transform-typescript-namespace-collisions.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "babel-preset",
    "litsx",
    "babel",
    "lit"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "homepage": "https://litsx.dev/",
  "bugs": {
    "url": "https://github.com/litsxdev/litsx/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/litsxdev/litsx.git",
    "directory": "packages/babel-preset-litsx"
  },
  "peerDependencies": {
    "@babel/core": "^8.0.0"
  },
  "dependencies": {
    "@babel/helper-plugin-utils": "^8.0.1",
    "@babel/parser": "^8.0.4",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/traverse": "^8.0.4",
    "@litsx/authoring": "^1.0.0-next.1",
    "@litsx/babel-plugin-shared-hooks": "^1.0.0-next.1",
    "@litsx/babel-plugin-transform-jsx-html-template": "^1.0.0-next.2",
    "@litsx/babel-plugin-transform-litsx-scoped-elements": "^1.0.0-next.1",
    "@litsx/typescript-session": "^1.0.0-next.0"
  },
  "scripts": {
    "build": "../../node_modules/.bin/rollup --config rollup.config.js",
    "prepack": "yarn build"
  }
}
