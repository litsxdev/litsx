{
  "name": "@litsx/ssr",
  "version": "0.1.0",
  "description": "Hydratable SSR integration for LitSX",
  "author": "LitSX Team",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "import": "./src/client.js",
      "require": "./dist/client.cjs",
      "default": "./src/client.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "litsx",
    "lit",
    "ssr",
    "hydration"
  ],
  "license": "Apache-2.0",
  "homepage": "https://litsx.dev/",
  "bugs": { "url": "https://github.com/litsxdev/litsx/issues" },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/litsxdev/litsx.git",
    "directory": "packages/ssr"
  },
  "dependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8"
  },
  "peerDependencies": {
    "lit": ">=3"
  },
  "scripts": {
    "build": "../../node_modules/.bin/rollup --config rollup.config.js",
    "prepack": "yarn build"
  }
}
